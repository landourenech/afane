export const marketplaceService = {
  async getProducts(filters: MarketplaceFilters): Promise<Product[]> {
    // Simuler un délai
    await new Promise((r) => setTimeout(r, 200));

    let products = [...MOCK_PRODUCTS];

    // Catégorie
    if (filters.category && filters.category !== 'all') {
      products = products.filter((p) => p.category === filters.category);
    }

    // Type vendeur
    if (filters.seller_type) {
      products = products.filter((p) => p.seller.type === filters.seller_type);
    }

    // Région
    if (filters.region) {
      products = products.filter((p) => p.location.region === filters.region);
    }

    // Prix
    if (filters.price_min !== null) {
      products = products.filter((p) => p.price_per_kg >= filters.price_min!);
    }
    if (filters.price_max !== null) {
      products = products.filter((p) => p.price_per_kg <= filters.price_max!);
    }

    // Mode de livraison
    if (filters.delivery_mode) {
      products = products.filter((p) =>
        p.delivery_modes.includes(filters.delivery_mode!)
      );
    }

    // Recherche
    if (filters.search) {
      const q = filters.search.toLowerCase();
      products = products.filter(
        (p) =>
          p.title.toLowerCase().includes(q) ||
          p.seller.name.toLowerCase().includes(q) ||
          p.location.city.toLowerCase().includes(q)
      );
    }

    // Badges
    if (filters.badges.length > 0) {
      products = products.filter((p) =>
        filters.badges.some((b) => p.badges.includes(b))
      );
    }

    // Tri
    switch (filters.sort) {
      case 'price_asc':
        products.sort((a, b) => a.price_per_kg - b.price_per_kg);
        break;
      case 'price_desc':
        products.sort((a, b) => b.price_per_kg - a.price_per_kg);
        break;
      case 'rating':
        products.sort((a, b) => b.rating - a.rating);
        break;
      case 'popular':
        products.sort((a, b) => b.reviews_count - a.reviews_count);
        break;
      case 'recent':
      default:
        break;
    }

    return products;
  },
};
